# Runtime-only refresh of the AXIOM Dynamo image (docker/Dockerfile.axiom-dynamo)
# on Dynamo 1.6.1, for A.X-K3 / K3 Flash serving.
#
# Swaps the base image's ai-dynamo-runtime for the SeungminHeo/dynamo CI build
# of work/solar-tool-arg-streaming-1.6.1 at f953bd9124ce (axiom/release/1.6.1
# plus streamed Solar Open2 tool calls and the repetition stop reported as a
# truncation), whose Rust frontend carries the Solar
# reasoning/tool parsing, the Hermes marker policy, the frontend repetition
# stop (DYN_REPETITION_DETECTION, reported to clients as `length`) and the A.X-K3
# `ax_k3` tool / reasoning parser (call_group_policy="all"). Serve K3 with:
#   python3 -m dynamo.frontend --dyn-chat-processor dynamo \
#       --dyn-tool-call-parser ax_k3 --dyn-reasoning-parser ax_k3 ...
#
# ai-dynamo 1.6.1 and the base image's Dynamo patches stay as they are; only
# the runtime wheel (Actions artifact, workflow run 43831704124) moves, installed
# with --no-deps and checked against the SHA-256 pin below.
#
# Build (amd64), on top of a pushed Dockerfile.axiom-dynamo image:
#   mkdir <ctx> && cp ai_dynamo_runtime-1.6.1-cp310-abi3-manylinux_2_28_x86_64.whl <ctx>/
#   podman build --platform linux/amd64 -f docker/Dockerfile.axiom-dynamo-axk3 \
#       --build-arg BASE_IMAGE=<registry>/vllm-runtime:<sha9>-axiom-dynamo1.6.1-axiomrt<rev12> \
#       --build-arg VLLM_SRC_COMMIT=$(git rev-parse HEAD) \
#       -t <registry>/vllm-runtime:<sha9>-axiom-dynamo1.6.1-axiomrt<rev12> <ctx>
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# uv segfaults under qemu user emulation; override with
# --build-arg INSTALLER="python3 -m pip install" for cross-arch local builds.
ARG INSTALLER="uv pip install --system"
ARG DYNAMO_VERSION=1.6.1
ARG DYNAMO_RUNTIME_COMMIT=f953bd9124ce009bb1e9f2f72610500de2a3da9b
ARG DYNAMO_RUNTIME_SHA256=784c7c5b19cab40b6e82348aa62ba6692737e542ccf97ea1e2a99bb3086abba1
ARG NIXL_VERSION=1.5.2

COPY ai_dynamo_runtime-${DYNAMO_VERSION}-cp310-abi3-manylinux_2_28_x86_64.whl /tmp/axk3-wheel/

RUN cd /tmp/axk3-wheel \
    && echo "${DYNAMO_RUNTIME_SHA256}  ai_dynamo_runtime-${DYNAMO_VERSION}-cp310-abi3-manylinux_2_28_x86_64.whl" \
        | sha256sum -c - \
    && ${INSTALLER} --no-deps --force-reinstall \
        ./ai_dynamo_runtime-${DYNAMO_VERSION}-cp310-abi3-manylinux_2_28_x86_64.whl \
    && cd / \
    && rm -rf /tmp/axk3-wheel \
    && python3 -c "\
import importlib.metadata as md, importlib.util; \
assert md.version('ai-dynamo') == md.version('ai-dynamo-runtime') == '${DYNAMO_VERSION}'; \
assert md.version('nixl-cu13') == '${NIXL_VERSION}', md.version('nixl-cu13'); \
from dynamo._core import get_reasoning_parser_names, get_tool_parser_names; \
tools, reasoning = set(get_tool_parser_names()), set(get_reasoning_parser_names()); \
assert {'ax_k3', 'solar_open2', 'hermes'} <= tools, sorted(tools); \
assert {'ax_k3', 'solar_open2'} <= reasoning, sorted(reasoning); \
assert all(importlib.util.find_spec(m) for m in ('dynamo.vllm', 'dynamo.frontend'))" \
    && python3 -c "import dynamo.vllm.main, dynamo.frontend.main"

ARG BASE_IMAGE
ARG VLLM_SRC_COMMIT=unknown
LABEL org.opencontainers.image.revision="${VLLM_SRC_COMMIT}" \
      ai.skt.dynamo.version="${DYNAMO_VERSION}" \
      ai.skt.dynamo.runtime_release="work/solar-tool-arg-streaming-1.6.1@f953bd9124ce" \
      ai.skt.dynamo.runtime_revision="${DYNAMO_RUNTIME_COMMIT}" \
      ai.skt.dynamo.runtime_sha256="${DYNAMO_RUNTIME_SHA256}" \
      ai.skt.axk3.base_image="${BASE_IMAGE}"
